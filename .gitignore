# Saídas de compilação
build/
bin/
*.o
*.d

# Saídas grandes e temporárias produzidas pelos scripts
data/raw/*.tmp
data/raw/*.partial
data/processed/*.tmp
figures/*.tmp
results/*.tmp

# Arquivos locais de ambiente
.venv/
analysis/.rendered/
analysis/.gitignore
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.DS_Store
.Rhistory
Projeto.pdf
graphics-material/

# Intermediários da compilação Beamer. As fontes e PDFs finais em slides/
# fazem parte da entrega e, portanto, não são ignorados.
slides/template.tex
slides/*.aux
slides/*.log
slides/*.nav
slides/*.out
slides/*.snm
slides/*.toc
slides/svg-inkscape/
